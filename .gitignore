dist/
build/
out/
.next/
.nuxt/
.output/
coverage/


# ==========================================
# Logs（日誌檔案）
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ==========================================
