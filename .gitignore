# ==========================================
.DS_Store
._*
.AppleDouble/
.Spotlight-V100/
.Trashes/
.fseventsd/


# ==========================================
# Windows（系統產生的檔案）
# ==========================================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/


# ==========================================
# IDE / Editor（編輯器設定）
# ==========================================
.idea/
*.swp
*.swo
*~

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json


# ==========================================
